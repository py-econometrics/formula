"""Type declarations for the native extension."""

from collections.abc import Sequence
from typing import ClassVar, TypeAlias

import polars

ParameterValue: TypeAlias = bool | int | float | str
ScalarValue: TypeAlias = bool | int | float | str | bytes | polars.Series
ComponentKey: TypeAlias = ScalarValue | None | tuple[ComponentKey, ...]

class Formula: ...

class Formulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> Formula: ...
    def fit(self, data: polars.DataFrame) -> FittedFormulas: ...

class FittedFormula:
    @property
    def formula(self) -> str: ...
    def transform(self, data: polars.DataFrame) -> FittedFormula: ...
    def frame(self) -> polars.DataFrame: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormula: ...
    def select_terms(self, source: str, role: Role) -> FittedFormula: ...
    def children(self, role: Role) -> FittedFormulas: ...
    def columns(self, role: Role) -> list[FormulaColumn]: ...

class FittedFormulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> FittedFormula: ...
    def transform(self, data: polars.DataFrame) -> FittedFormulas: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormulas: ...

class Factor:
    @property
    def name(self) -> str | None: ...
    @property
    def value(self) -> object: ...
    @property
    def transform(self) -> TransformCall | None: ...

class TransformCall:
    @property
    def name(self) -> str: ...
    @property
    def inputs(self) -> list[Factor]: ...
    @property
    def parameters(self) -> dict[str, ParameterValue]: ...

class FormulaColumn:
    @property
    def data(self) -> polars.Series: ...
    @property
    def term(self) -> tuple[Factor, ...]: ...
    @property
    def contributions(self) -> tuple[FactorContribution, ...]: ...

class FactorContribution:
    @property
    def factor(self) -> Factor: ...
    @property
    def key(self) -> ComponentKey: ...

class Role:
    Dependent: ClassVar[Role]
    Independent: ClassVar[Role]
    FixedEffect: ClassVar[Role]

def parse(formulas: str) -> Formulas: ...
def parse_many(formulas: Sequence[str]) -> Formulas: ...
