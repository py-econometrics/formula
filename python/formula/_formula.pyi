"""Type declarations for the native extension."""

from collections.abc import Sequence
from typing import ClassVar

import polars

class Specification:
    def fit(self, data: polars.DataFrame) -> Models: ...

class Model:
    @property
    def formula(self) -> str: ...
    def transform(self, data: polars.DataFrame) -> Model: ...
    def frame(self) -> polars.DataFrame: ...
    def select(self, roles: Role | Sequence[Role]) -> Model: ...
    def children(self, role: Role) -> Models: ...

class Models:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> Model: ...
    def transform(self, data: polars.DataFrame) -> Models: ...
    def select(self, roles: Role | Sequence[Role]) -> Models: ...

class Role:
    Dependent: ClassVar[Role]
    Independent: ClassVar[Role]
    FixedEffect: ClassVar[Role]

def parse(formulas: str) -> Specification: ...
def parse_many(formulas: Sequence[str]) -> Specification: ...
