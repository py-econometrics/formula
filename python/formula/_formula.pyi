"""Type declarations for the native extension."""

from collections.abc import Iterator, Sequence
from typing import ClassVar, TypeAlias

import polars

ParameterValue: TypeAlias = bool | int | float | str | list[bool | int | float | str]
ScalarValue: TypeAlias = bool | int | float | str | bytes | polars.Series
ComponentKey: TypeAlias = ScalarValue | None | tuple[ComponentKey, ...]

class Formula: ...

class RankDeficiencyWarning(UserWarning):
    """Terms without columns, because the intercept, fixed effects, or other terms
    already span them, whatever the data."""

class Formulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> Formula: ...
    def fit(
        self, data: polars.DataFrame, *, ensure_full_rank: bool = True
    ) -> FittedFormulas: ...

class FittedFormula:
    @property
    def formula(self) -> str: ...
    def transform(self, data: polars.DataFrame) -> FittedFormula: ...
    def frame(self) -> polars.DataFrame: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormula: ...
    def select_terms(self, source: str, role: Role) -> FittedFormula: ...
    def children(self, role: Role) -> FittedFormulas: ...
    def columns(self, role: Role) -> list[FormulaColumn]: ...
    def terms(self, role: Role) -> list[FittedTerm]: ...
    @property
    def fixed_effects(self) -> list[FixedEffect]: ...
    def fixed_effect(self, name: str) -> FixedEffect: ...

class FittedFormulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> FittedFormula: ...
    def transform(self, data: polars.DataFrame) -> FittedFormulas: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormulas: ...

class FittedTerm:
    @property
    def factors(self) -> tuple[Factor, ...]: ...
    @property
    def columns(self) -> tuple[FormulaColumn, ...]: ...
    @property
    def fixed_effect(self) -> FixedEffect | None: ...

class FixedEffect:
    @property
    def codes(self) -> polars.Series: ...
    @property
    def loadings(self) -> polars.DataFrame: ...
    @property
    def intercept(self) -> bool: ...
    @property
    def encoding(self) -> FixedEffectEncoding: ...

class FixedEffectEncoding:
    @property
    def codes(self) -> polars.DataFrame: ...
    @property
    def levels(self) -> polars.DataFrame: ...

class Factor:
    @property
    def name(self) -> str | None: ...
    @property
    def value(self) -> object: ...
    @property
    def transform(self) -> TransformCall | None: ...

class TransformCall:
    @property
    def name(self) -> str: ...
    @property
    def inputs(self) -> list[Factor]: ...
    @property
    def parameters(self) -> dict[str, ParameterValue]: ...
    @property
    def state(self) -> TransformState | None: ...

class TransformState:
    def __getitem__(self, name: str) -> ScalarValue | polars.DataFrame | None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...

class FormulaColumn:
    @property
    def data(self) -> polars.Series: ...
    @property
    def term(self) -> tuple[Factor, ...]: ...
    @property
    def contributions(self) -> tuple[FactorContribution, ...]:
        """The factors of `term` this column includes, in term order, with their keys.

        Full-rank coding can split a term into column groups that omit some of its
        factors: in `y ~ a:b`, the column `b[T.v]` belongs to the term `a:b` but
        includes only `b`. Omitted factors have no contribution, and the intercept
        column has none.
        """

class FactorContribution:
    @property
    def factor(self) -> Factor: ...
    @property
    def key(self) -> ComponentKey: ...

class Role:
    Dependent: ClassVar[Role]
    Independent: ClassVar[Role]
    FixedEffect: ClassVar[Role]

def parse(formulas: str) -> Formulas: ...
def parse_many(formulas: Sequence[str]) -> Formulas: ...
