"""Type declarations for the native extension."""

from collections.abc import Sequence
from typing import ClassVar

import polars

class Formula: ...

class Formulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> Formula: ...
    def fit(self, data: polars.DataFrame) -> FittedFormulas: ...

class FittedFormula:
    @property
    def formula(self) -> str: ...
    def transform(self, data: polars.DataFrame) -> FittedFormula: ...
    def frame(self) -> polars.DataFrame: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormula: ...
    def children(self, role: Role) -> FittedFormulas: ...

class FittedFormulas:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int | str) -> FittedFormula: ...
    def transform(self, data: polars.DataFrame) -> FittedFormulas: ...
    def select(self, roles: Role | Sequence[Role]) -> FittedFormulas: ...

class Role:
    Dependent: ClassVar[Role]
    Independent: ClassVar[Role]
    FixedEffect: ClassVar[Role]

def parse(formulas: str) -> Formulas: ...
def parse_many(formulas: Sequence[str]) -> Formulas: ...
